# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Build / dist
build/
dist/
*.spec
!R7-Testovarka.spec
*.zip

# IDE
.idea/
*.iml
.vscode/

# Executables & installers
*.exe
*.msi

# Test outputs & reports
TestResults/
TestFiles/
Reports/
*.html
*.xlsx
*.csv
*.pdf

# JSON, который пишет сама программа: настройки и история — в корне
# (selected_tests.json, r7_settings.json, ui_settings.json, last_*.json,
# performance_*.json), эталоны хэшей — рядом с дистрибутивами, профиль шума и
# пакеты улик — в Reports/ (игнорируется целиком). Прежний *.json прятал и
# будущие JSON-фикстуры тестов.
/*.json
Distributives/
*.json.tmp
!tests/fixtures/**/*.json

# Logs
*.log

# Superpowers subagent-driven-development scratch workspace
.superpowers/
.claude/
.venv-ci/
# Шаблоны HTML-отчётов — исходники, не результат прогона
!templates/html/*.html
!docs/diagrams/*.html
!docs/slides/*.html

# отчёт coverage.py
.coverage

.tmpvenv/

# база примеров Hypothesis
.hypothesis/
# Фикстуры и эталоны тестов — исходники, не результат прогона
!tests/fixtures/**
!tests/fixtures/golden/*.html
